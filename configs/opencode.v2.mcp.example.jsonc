{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "project-context": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "tsx",
          "mcp/starter-typescript/src/index.ts"
        ],
        "cwd": ".",
        "environment": {
          "AI_ENGINEERING_ROOT": "."
        },
        "disabled": true
      }
    }
  }
}
