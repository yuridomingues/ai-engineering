{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode 2 auto-discovers Ollama and LM Studio on their default local endpoints.
  // Replace this with a model actually installed on your machine.
  "model": "ollama/your-installed-model",

  // Providers are only needed here when overriding defaults.
  "providers": {
    "ollama": {
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "lmstudio": {
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1"
      }
    }
  }
}
