{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode 2 auto-discovers Ollama at 127.0.0.1:11434
  // and LM Studio at 127.0.0.1:1234.
  // Pick an installed model from /models rather than guessing IDs.
  "model": "ollama/your-installed-model",

  // Only needed when using non-default local endpoints.
  "providers": {
    "ollama": {
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    },
    "lmstudio": {
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1"
      }
    }
  }
}
