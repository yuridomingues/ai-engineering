{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode 2 is currently a separately installed beta.
  // This file demonstrates native V2 permission syntax; keep opencode.jsonc
  // as the stable V1-compatible project configuration until you intentionally migrate.
  "share": "disabled",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" }
  ]
}
