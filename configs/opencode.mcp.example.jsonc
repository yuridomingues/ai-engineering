{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "project-context": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tsx",
        "mcp/starter-typescript/src/index.ts"
      ],
      "enabled": false,
      "environment": {
        "AI_ENGINEERING_ROOT": "."
      }
    }
  }
}
