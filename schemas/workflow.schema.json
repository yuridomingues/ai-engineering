{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Workflow",
  "type": "object",
  "required": [
    "id",
    "version",
    "nodes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "objective",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "agent": {
            "type": "string"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "mode": {
            "enum": [
              "single",
              "fanout",
              "fanin",
              "gate"
            ]
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "objective": {
            "type": "string"
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional": {
            "type": "boolean"
          }
        },
        "anyOf": [
          {
            "required": [
              "agent"
            ]
          },
          {
            "required": [
              "agents"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
