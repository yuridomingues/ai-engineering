{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Evidence Record",
  "type": "object",
  "required": [
    "timestamp",
    "node",
    "path",
    "sha256",
    "summary"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
